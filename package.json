{
  "name": "nexus",
  "version": "1.0.2",
  "private": true,
  "description": "Asistente de escritorio para Windows al estilo J.A.R.V.I.S.: voz, agente con herramientas y fondo de escritorio animado.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win dir",
    "test": "vitest run",
    "release": "electron-vite build && electron-builder --win nsis zip --publish never && node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ical.js": "^2.2.1",
    "msedge-tts": "^2.0.8",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "tar-stream": "^3.2.1",
    "unbzip2-stream": "^1.4.3",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "author": "AleixAj",
  "build": {
    "appId": "com.aleixaj.nexus",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "dir",
      "artifactName": "NEXUS-Portable.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "NEXUS-Setup.exe",
      "shortcutName": "NEXUS"
    },
    "publish": {
      "provider": "github",
      "owner": "AleixAj",
      "repo": "nexus",
      "releaseType": "draft"
    }
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "license": "MIT"
}
