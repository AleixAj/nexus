{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente virtual de escritorio con núcleo de IA",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "msedge-tts": "^2.0.8",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "tar-stream": "^3.2.1",
    "unbzip2-stream": "^1.4.3",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "author": "AleixAj",
  "build": {
    "appId": "com.aleixaj.nexus",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": "dir"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
